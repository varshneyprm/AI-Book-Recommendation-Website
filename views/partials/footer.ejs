    <!-- 
        Mobile Responsiveness Script
        Handles the accordion logic for the footer menus on devices narrower than 768px.
        Automatically resets the view to a standard horizontal layout if the device is rotated to landscape or scaled up.
    -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const toggles = document.querySelectorAll('.footer-toggle');

            toggles.forEach(toggle => {
                toggle.addEventListener('click', () => {
                    if (window.innerWidth < 768) {
                        const menu = toggle.nextElementSibling;
                        const icon = toggle.querySelector('.arrow-icon');
                        const isExpanded = toggle.getAttribute('aria-expanded') === 'true';

                        toggle.setAttribute('aria-expanded', !isExpanded);

                        if (!isExpanded) {
                            menu.classList.remove('hidden');
                            icon.classList.add('rotate-180');
                        } else {
                            menu.classList.add('hidden');
                            icon.classList.remove('rotate-180');
                        }
                    }
                });
            });

            window.addEventListener('resize', () => {
                if (window.innerWidth >= 768) {
                    document.querySelectorAll('.footer-menu').forEach(menu => menu.classList.remove('hidden'));
                    document.querySelectorAll('.arrow-icon').forEach(icon => icon.classList.remove('rotate-180'));
                } else {
                    toggles.forEach(toggle => {
                        if (toggle.getAttribute('aria-expanded') !== 'true') {
                            toggle.nextElementSibling.classList.add('hidden');
                        }
                    });
                }
            });
        });
    </script>
