<!-- 
    Admin Sidebar Partial
    Purpose: Provides the primary navigation interface for the administrative dashboard.
    Connection: Included in all admin-facing views (dashboard, users, inventory) to maintain a consistent layout.
-->
<aside class="w-64 bg-[#0B1120] text-gray-300 min-h-screen border-r border-gray-800 flex flex-col hidden md:flex">

    <!-- Renders the branding section at the top of the sidebar -->
    <div class="p-6 border-b border-gray-800 flex items-center gap-4">
        <img src="/images/GranthSyncLogo.png" alt="GranthSync Logo"
            class="h-10 w-auto rounded shadow-sm transition-transform duration-300">
        <div class="flex flex-col">
            <span class="text-xl font-black text-white tracking-tight leading-none mb-1.5">GranthSync</span>
            <span
                class="text-[10px] font-bold text-indigo-400 uppercase tracking-widest bg-indigo-500/10 py-0.5 px-2 rounded w-fit border border-indigo-500/20">Admin
                Portal</span>
        </div>
    </div>

    <!-- 
        Navigation Links
        Uses EJS templating to check the 'activePage' variable passed from the controller.
        This dynamically applies highlighting to show the admin exactly which page they are currently viewing.
    -->
    <nav class="flex-1 p-4 space-y-2 mt-4">
        <a href="/admin"
            class="block px-4 py-3 rounded-lg hover:bg-[#1e293b] hover:text-white transition <%= activePage === 'admin' ? 'bg-[#1e293b] text-white border-l-4 border-indigo-500' : '' %>">Dashboard</a>
        <a href="/admin/users"
            class="block px-4 py-3 rounded-lg hover:bg-[#1e293b] hover:text-white transition <%= activePage === 'admin-users' ? 'bg-[#1e293b] text-white border-l-4 border-indigo-500' : '' %>">User
            Management</a>
        <a href="/admin/inventory"
            class="block px-4 py-3 rounded-lg hover:bg-[#1e293b] hover:text-white transition <%= activePage === 'admin-inventory' ? 'bg-[#1e293b] text-white border-l-4 border-indigo-500' : '' %>">Book
            Inventory</a>
    </nav>

    <!-- Secures the session by providing a clear exit path that destroys the authentication cookie -->
    <div class="p-4 border-t border-gray-800">
        <a href="/logout"
            class="block w-full text-center px-4 py-3 bg-red-500/10 text-red-400 font-bold rounded-lg hover:bg-red-500/20 transition border border-red-500/20">Logout</a>
    </div>

    <!-- Applies a subtle background watermark for visual polish -->
    <div class="fixed inset-0 flex items-center justify-center pointer-events-none z-[-1] opacity-10">
        <img src="/images/GranthSyncLogo.png" alt="Watermark" class="w-full max-w-2xl px-10 ">
    </div>
</aside>