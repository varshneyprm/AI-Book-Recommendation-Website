<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Book Inventory - GranthSync Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#0B1120] text-gray-100 min-h-screen flex">
    <%- include('partials/adminSidebar', { activePage: 'admin-inventory' }) %>

    <main class="flex-grow p-10 overflow-y-auto h-screen">
        <div class="flex justify-between items-center mb-8">
            <h1 class="text-3xl font-black text-white">Book Inventory</h1>
            <span class="bg-indigo-500/20 text-indigo-300 px-4 py-2 rounded-lg font-bold border border-indigo-500/30">Books Indexed: <%= books.length %></span>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            <% if (books.length > 0) { %>
                <% books.forEach(book => { %>
                <div class="bg-[#1e293b] p-4 rounded-2xl border border-gray-700 flex flex-col gap-4 shadow-lg hover:shadow-indigo-500/20 transition group" id="book-<%= book._id %>">
                    <div class="flex gap-4 h-32">
                        <img src="<%= book.thumbnail %>" alt="<%= book.title %>" class="w-20 h-full object-cover rounded shadow-md group-hover:scale-105 transition">
                        <div class="flex flex-col flex-grow overflow-hidden">
                            <h4 class="font-bold text-white text-sm line-clamp-2"><%= book.title %></h4>
                            <p class="text-indigo-400 text-xs mb-1 line-clamp-1"><%= book.authors ? book.authors[0] : 'Unknown' %></p>
                            <p class="text-gray-500 text-xs mt-auto">ID: <%= book._id.toString().substring(0,6) %>...</p>
                        </div>
                    </div>
                    <button onclick="deleteBook('<%= book._id %>')" class="w-full text-sm font-bold bg-red-500/10 text-red-400 hover:bg-red-500/20 py-2 rounded-lg transition border border-red-500/20">Purge from Database</button>
                </div>
                <% }) %>
            <% } else { %>
                <div class="col-span-full py-12 text-center text-gray-500 bg-[#1e293b] rounded-2xl border border-gray-700">
                    No books currently indexed. Use the Standard Search or AI Co-Pilot to populate the database.
                </div>
            <% } %>
        </div>
    </main>

    <script>
        async function deleteBook(bookId) {
            if (confirm('Are you sure you want to purge this book from the local database?')) {
                const res = await fetch(`/api/admin/books/${bookId}`, { method: 'DELETE' });
                const data = await res.json();
                if (data.success) {
                    document.getElementById(`book-${bookId}`).remove();
                } else {
                    alert('Error deleting book.');
                }
            }
        }
    </script>
</body>
</html>