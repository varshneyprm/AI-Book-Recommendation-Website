<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= book.title %> - GranthSync
    </title>
    <link rel="icon" type="image/jpeg" href="/images/GranthSyncLogo.jpg">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        // Wait for the HTML to fully load before running the script
        document.addEventListener('DOMContentLoaded', () => {
            const bookId = '<%= book._id %>';

            async function handleInteraction(btnId, type, successText, successClasses) {
                const btn = document.getElementById(btnId);
                const originalText = btn.innerHTML;

                btn.disabled = true;
                btn.innerHTML = "Processing...";

                try {
                    // Hitting your actual telemetry route
                    const response = await fetch('/api/telemetry/track', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ bookId: bookId, interactionType: type })
                    });

                    // Check if the server redirected us to the login page
                    if (response.redirected && response.url.includes('/login')) {
                        window.location.href = '/login';
                        return;
                    }

                    const result = await response.json();

                    if (result.success) {
                        btn.innerHTML = successText;
                        btn.className = successClasses;
                    } else {
                        btn.innerHTML = originalText;
                        btn.disabled = false;
                        console.error(result.message);
                    }
                } catch (err) {
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                    console.error("Failed to connect to server.", err);
                }
            }

            // Safely grab the buttons and attach listeners
            const readBtn = document.getElementById('btn-read');
            if (readBtn) {
                readBtn.addEventListener('click', () => {
                    handleInteraction(
                        'btn-read',
                        'completed', // Tells the backend this book is finished
                        '✅ Bookmarked', // Matches your screenshot
                        'bg-green-600 hover:bg-green-700 text-white px-8 py-4 rounded-xl font-bold shadow-lg transition transform hover:-translate-y-1'
                    );
                });
            }

            const wishlistBtn = document.getElementById('btn-wishlist');
            if (wishlistBtn) {
                wishlistBtn.addEventListener('click', () => {
                    handleInteraction(
                        'btn-wishlist',
                        'wishlist',
                        '✅ Wishlisted',
                        'bg-indigo-50 border-2 border-indigo-600 text-indigo-700 px-8 py-4 rounded-xl font-bold shadow-sm transition transform hover:-translate-y-1'
                    );
                });
            }
        });
    </script>

</head>

<body class="bg-gray-50 text-gray-800 font-sans min-h-screen flex flex-col">
    <header class="bg-white shadow-sm sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex justify-between items-center">
            <a href="/" class="text-3xl font-black text-indigo-600 tracking-tight">GranthSync</a>
        </div>
    </header>

    <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 w-full">
        <div
            class="bg-white rounded-3xl shadow-xl overflow-hidden mb-16 flex flex-col md:flex-row border border-gray-100">
            <div
                class="md:w-1/3 flex-shrink-0 bg-gray-50 p-10 flex justify-center items-center border-r border-gray-100">
                <img src="<%= book.thumbnail %>" alt="<%= book.title %> Cover"
                    class="rounded-xl shadow-2xl max-w-full h-auto object-cover transform hover:scale-105 transition duration-500">
            </div>
            <div class="p-10 md:w-2/3 flex flex-col justify-center">
                <h1 class="text-4xl font-black text-gray-900 mb-3">
                    <%= book.title %>
                </h1>
                <h2 class="text-2xl text-indigo-600 font-semibold mb-6">
                    <%= book.authors.join(', ') %></h2>
                <div class="flex flex-wrap items-center gap-3 mb-8">
                    <span class="bg-yellow-100 text-yellow-800 text-sm font-bold px-3 py-1 rounded-full flex items-center">
                        ⭐ <%= book.averageRating %> (<%= book.ratingsCount %> ratings)
                    </span>
                    <span class="bg-indigo-50 text-indigo-700 text-sm font-bold px-3 py-1 rounded-full">
                        <%= book.categories.join(' , ') %>
                    </span>
                    <span class="bg-gray-100 text-gray-600 text-sm font-bold px-3 py-1 rounded-full">
                        <%= book.pageCount %> pages
                    </span>
                </div>
                <p class="text-gray-600 text-lg leading-relaxed mb-10"><%= book.description %></p>
                <div class="mt-auto flex gap-4">
                   <button id="btn-read" class="bg-indigo-600 hover:bg-indigo-700 text-white px-8 py-4 rounded-xl font-bold shadow-lg transition transform hover:-translate-y-1">Mark As Read</button>

                    <button id="btn-wishlist" class="bg-white border-2 border-indigo-100 text-indigo-600 hover:border-indigo-600 px-8 py-4 rounded-xl font-bold shadow-sm transition transform hover:-translate-y-1">Add to Wishlist</button>
                </div>
            </div>
        </div>

        <div class="mb-12">
            <h3 class="text-3xl font-extrabold text-gray-900 mb-8 flex items-center gap-3">
                <svg class="w-8 h-8 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                AI Recommendations
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
                <% if (similarBooks && similarBooks.length > 0) { %>
                    <% similarBooks.forEach(function(simBook) { %>
                        <a href="/book/<%= simBook._id %>" class="group bg-white rounded-2xl shadow-md hover:shadow-2xl transition duration-300 transform hover:-translate-y-2 overflow-hidden flex flex-col border border-gray-100 relative">
                            <div class="absolute top-3 left-3 right-3 z-10">
                                <span class="bg-gray-900/90 backdrop-blur-sm text-white text-xs font-bold px-3 py-2 rounded-lg shadow-sm block text-center truncate border border-gray-700">
                                    💡 Recommended because you viewed "<%= book.title %>"
                                </span>
                            </div>
                            <div class="bg-gray-100 p-6 flex justify-center items-center h-64 pt-16">
                                <img src="<%= simBook.thumbnail %>" alt="<%= simBook.title %>" class="h-full object-cover rounded shadow-lg group-hover:scale-105 transition duration-500">
                            </div>
                            <div class="p-6 flex-grow flex flex-col">
                                <h4 class="font-extrabold text-gray-900 text-lg mb-2 line-clamp-2"><%= simBook.title %></h4>
                                <p class="text-sm text-gray-500 font-medium mb-2 line-clamp-1"><%= simBook.authors[0] %></p>
                            </div>
                        </a>
                    <% }); %>
                <% } else { %>
                    <div class="col-span-full bg-gray-50 rounded-xl p-8 text-center border-2 border-dashed border-gray-200">
                        <p class="text-gray-500 font-medium text-lg">Our AI model requires more user interactions to generate recommendations for this book.</p>
                    </div>
                <% } %>
            </div>
        </div>

         <%- include(' partials/footer') %>
         
    </main>
</body>

</html>