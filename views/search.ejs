<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GranthSync - Discover Books</title>
    <link rel="icon" type="image/jpeg" href="/images/GranthSyncLogo.png">
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-50 text-gray-800 font-sans min-h-screen flex flex-col">
    
    <!-- Dynamic Header Partial -->
    <%- include('partials/header') %>

    <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 w-full pb-24 md:pb-12">
        <div class="text-center mb-16">
            <h2 class="text-5xl font-extrabold text-gray-900 mb-6">Discover Your Next Great Read</h2>
            <p class="text-xl text-gray-600 mb-10 max-w-2xl mx-auto">Our AI algorithms analyze thousands of vectors to find the perfect literary match for your unique tastes.</p>
            <form id="search-form" class="max-w-2xl mx-auto flex gap-3">
                <input type="text" id="search-input" placeholder="Search by title, author, or specific genre..." required
                    class="flex-1 px-6 py-4 text-lg rounded-xl border border-gray-300 focus:ring-4 focus:ring-indigo-100 focus:border-indigo-500 shadow-sm outline-none transition">
                <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white px-8 py-4 rounded-xl text-lg font-bold shadow-md transition transform hover:-translate-y-1">Explore</button>
            </form>
        </div>

        <div id="loading-spinner" class="hidden flex justify-center my-16">
            <div class="animate-spin rounded-full h-16 w-16 border-t-4 border-b-4 border-indigo-600"></div>
        </div>

        <div id="results-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
        </div>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>

    <!-- Mobile Nav Partial (Safe Include) -->
    <%- include('partials/mobileNav', { activePage: typeof activePage !== 'undefined' ? activePage : 'home' }) %>

</body>
</html>